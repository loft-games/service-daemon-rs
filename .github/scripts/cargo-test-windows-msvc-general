#!/usr/bin/env bash
set -euo pipefail

target="${1:-x86_64-pc-windows-msvc}"
shift || true

cargo_flags=(--target "$target")
if [[ "$#" -gt 0 ]]; then
  cargo_flags+=("$@")
fi

cargo test "${cargo_flags[@]}" --workspace \
  --exclude service-daemon \
  --exclude example-unix-domain-socket \
  --exclude example-named-pipe

cargo test "${cargo_flags[@]}" -p service-daemon --lib
cargo test "${cargo_flags[@]}" -p service-daemon --doc

# Platform-specific IPC suites have dedicated jobs. Keep this job focused on
# cross-platform runtime behavior that should work on Windows MSVC.
for test_file in service-daemon/tests/*.rs; do
  test_name="$(basename "${test_file%.rs}")"
  case "$test_name" in
    local_ipc_* | named_pipe_* | unix_*)
      echo "Skipping platform-specific IPC test target: ${test_name}"
      ;;
    *)
      cargo test "${cargo_flags[@]}" -p service-daemon --test "$test_name"
      ;;
  esac
done

# Exercise code that is compiled out of the default-feature test pass. Keep
# this list focused on integration targets whose behavior changes under one or
# more optional features; platform-specific IPC remains owned by its dedicated
# jobs.
cargo test "${cargo_flags[@]}" -p service-daemon --all-features --lib
cargo test "${cargo_flags[@]}" -p service-daemon --all-features --doc

feature_integration_tests=(
  eager_integration_tests
  file_logging_degrade_tests
  high_priority_runtime_policy_tests
  provider_contract_integration_tests
  provider_ownership_characterization
  reload_integration_tests
  scheduling_integration
  service_handle_integration_tests
)

for test_name in "${feature_integration_tests[@]}"; do
  cargo test "${cargo_flags[@]}" -p service-daemon --all-features --test "$test_name"
done

# The minimal feature surface must also keep compiling on Windows. Linux owns
# the exhaustive no-default-features test and Clippy gates.
cargo check "${cargo_flags[@]}" -p service-daemon --no-default-features
